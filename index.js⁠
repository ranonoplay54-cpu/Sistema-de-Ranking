require('dotenv').config();
const {
  Client,
  GatewayIntentBits,
  REST,
  Routes,
  SlashCommandBuilder,
  EmbedBuilder,
  ActionRowBuilder,
  ButtonBuilder,
  ButtonStyle,
  UserSelectMenuBuilder
} = require('discord.js');
const { Pool } = require('pg');

// ==========================================
// CONFIGURAÇÕES E BANCO DE DADOS (POSTGRESQL)
// ==========================================
const OWNER_ROLE_ID = process.env.OWNER_ROLE_ID;
const RANKING_CHANNEL_ID = process.env.RANKING_CHANNEL_ID;

const isProduction = process.env.NODE_ENV === 'production' || !!process.env.RAILWAY_ENVIRONMENT;
const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: isProduction ? { rejectUnauthorized: false } : false
});

async function initDB() {
  const client = await pool.connect();
  try {
    await client.query(`
      CREATE TABLE IF NOT EXISTS config (
        key VARCHAR(50) PRIMARY KEY,
        value TEXT NOT NULL
      );
    `);

    await client.query(`
      CREATE TABLE IF NOT EXISTS players (
        user_id VARCHAR(32) PRIMARY KEY,
        username VARCHAR(100) NOT NULL,
        points INT DEFAULT 0,
        wins INT DEFAULT 0,
        penalties INT DEFAULT 0,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
      );
    `);

    await client.query(`
      CREATE TABLE IF NOT EXISTS history (
        id SERIAL PRIMARY KEY,
        user_id VARCHAR(32) NOT NULL,
        action VARCHAR(50) NOT NULL,
        points_changed INT NOT NULL,
        author_id VARCHAR(32) NOT NULL,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
      );
    `);
    console.log('[BANCO] Estrutura inicializada com sucesso.');
  } finally {
    client.release();
  }
}

// Helpers de Banco de Dados
async function getPanelMessageId() {
  const res = await pool.query('SELECT value FROM config WHERE key = $1', ['panel_message_id']);
  return res.rows[0]?.value || null;
}

async function setPanelMessageId(messageId) {
  await pool.query(
    'INSERT INTO config (key, value) VALUES ($1, $2) ON CONFLICT (key) DO UPDATE SET value = $2',
    ['panel_message_id', messageId]
  );
}

async function addPlayer(userId, username) {
  await pool.query(
    'INSERT INTO players (user_id, username, points, wins, penalties) VALUES ($1, $2, 0, 0, 0) ON CONFLICT (user_id) DO NOTHING',
    [userId, username]
  );
}

async function removePlayer(userId) {
  await pool.query('DELETE FROM players WHERE user_id = $1', [userId]);
}

async function getPlayer(userId) {
  const res = await pool.query('SELECT * FROM players WHERE user_id = $1', [userId]);
  return res.rows[0];
}

async function getAllPlayers() {
  const res = await pool.query('SELECT * FROM players ORDER BY points DESC, wins DESC, username ASC');
  return res.rows;
}

async function registerWin(userId, authorId) {
  await pool.query('UPDATE players SET points = points + 3, wins = wins + 1 WHERE user_id = $1', [userId]);
  await pool.query('INSERT INTO history (user_id, action, points_changed, author_id) VALUES ($1, $2, 3, $3)', [userId, 'WIN', authorId]);
}

async function removeWin(userId, authorId) {
  await pool.query('UPDATE players SET points = GREATEST(0, points - 3), wins = GREATEST(0, wins - 1) WHERE user_id = $1', [userId]);
  await pool.query('INSERT INTO history (user_id, action, points_changed, author_id) VALUES ($1, $2, -3, $3)', [userId, 'REMOVE_WIN', authorId]);
}

async function applyPenalty(userId, authorId) {
  await pool.query('UPDATE players SET points = GREATEST(0, points - 2), penalties = penalties + 1 WHERE user_id = $1', [userId]);
  await pool.query('INSERT INTO history (user_id, action, points_changed, author_id) VALUES ($1, $2, -2, $3)', [userId, 'PENALTY', authorId]);
}

// ==========================================
// CONSTRUTORES DE EMBEDS E BOTÕES
// ==========================================
function buildPanelComponents() {
  const embed = new EmbedBuilder()
    .setTitle('⚡ PAINEL DE CONTROLE — RANKING OFICIAL ⚡')
    .setDescription(
      'Sistema de controle e pontuação individual.\n\n' +
      '**Regras de Pontuação:**\n' +
      '🟢 **Vitória:** `+3 pontos`\n' +
      '🔴 **Remover Vitória:** `-3 pontos`\n' +
      '⚠️ **Penalidade:** `-2 pontos`\n' +
      '👤 **Novo Jogador:** Inicializa com `0 pontos`\n\n' +
      'Selecione uma ação abaixo:'
    )
    .setColor('#FF4500')
    .setFooter({ text: 'Sistema Oficial • Ranking Free Fire' })
    .setTimestamp();

  const row1 = new ActionRowBuilder().addComponents(
    new ButtonBuilder().setCustomId('btn_win').setLabel('Definir Vencedor').setEmoji('🟢').setStyle(ButtonStyle.Success),
    new ButtonBuilder().setCustomId('btn_remove_win').setLabel('Remover Vitória').setEmoji('🔴').setStyle(ButtonStyle.Danger),
    new ButtonBuilder().setCustomId('btn_penalty').setLabel('Penalizar').setEmoji('⚠️').setStyle(ButtonStyle.Secondary)
  );

  const row2 = new ActionRowBuilder().addComponents(
    new ButtonBuilder().setCustomId('btn_add_player').setLabel('Adicionar Jogador').setEmoji('👤').setStyle(ButtonStyle.Primary),
    new ButtonBuilder().setCustomId('btn_remove_player').setLabel('Remover Jogador').setEmoji('❌').setStyle(ButtonStyle.Danger),
    new ButtonBuilder().setCustomId('btn_view_ranking').setLabel('Ver Ranking').setEmoji('🏆').setStyle(ButtonStyle.Success)
  );

  return { embed, components: [row1, row2] };
}

function buildRankingEmbed(players) {
  const embed = new EmbedBuilder()
    .setTitle('🏆 RANKING INDIVIDUAL 🏆')
    .setColor('#FFD700')
    .setFooter({ text: 'Atualizado em tempo real' })
    .setTimestamp();

  if (!players || players.length === 0) {
    embed.setDescription('Nenhum jogador cadastrado no ranking até o momento.');
    return embed;
  }

  const medals = ['🥇', '🥈', '🥉'];
  const rankingList = players.map((p, i) => {
    const medal = medals[i] || `${i + 1}️⃣`;
    return `${medal} <@${p.user_id}> — **${p.points} pontos** \`(${p.wins}V | ${p.penalties}P)\``;
  });

  embed.setDescription(rankingList.join('\n'));
  return embed;
}

// ==========================================
// CLIENTE DISCORD E CONTROLE DE EVENTOS
// ==========================================
const client = new Client({
  intents: [
    GatewayIntentBits.Guilds,
    GatewayIntentBits.GuildMembers
  ]
});

function hasOwnerRole(member) {
  if (!member || !member.roles) return false;
  return member.roles.cache.has(OWNER_ROLE_ID);
}

async function registerSlashCommands(clientId) {
  const commands = [
    new SlashCommandBuilder()
      .setName('ranking')
      .setDescription('Publica/atualiza o painel de ranking persistente')
  ].map(cmd => cmd.toJSON());

  const rest = new REST({ version: '10' }).setToken(process.env.DISCORD_TOKEN);
  await rest.put(Routes.applicationCommands(clientId), { body: commands });
  console.log('[BOT] Comando /ranking registrado globalmente.');
}

client.once('ready', async () => {
  console.log(`[BOT] Conectado com sucesso como ${client.user.tag}`);
  
  await initDB();
  await registerSlashCommands(client.user.id);

  // Sincronização e reativação do painel persistente
  try {
    const channel = await client.channels.fetch(RANKING_CHANNEL_ID).catch(() => null);
    if (channel) {
      const savedMsgId = await dbGetPanelId();
      if (savedMsgId) {
        try {
          const message = await channel.messages.fetch(savedMsgId);
          const { embed, components } = buildPanelComponents();
          await message.edit({ embeds: [embed], components });
          console.log('[BOT] Painel persistente localizado e sincronizado.');
        } catch {
          console.log('[BOT] Mensagem do painel anterior não encontrada no canal. Use /ranking para recriá-la.');
        }
      }
    }
  } catch (err) {
    console.error('[BOT] Erro ao sincronizar painel:', err);
  }
});

// Alias interno para leitura do id
async function dbGetPanelId() {
  return await getPanelMessageId();
}

client.on('interactionCreate', async (interaction) => {
  try {
    // 1. Comando Slash /ranking
    if (interaction.isChatInputCommand() && interaction.commandName === 'ranking') {
      if (!hasOwnerRole(interaction.member)) {
        return interaction.reply({
          content: '🔒 Você não possui permissão para utilizar esta função.',
          ephemeral: true
        });
      }

      const channel = await client.channels.fetch(RANKING_CHANNEL_ID).catch(() => null);
      if (!channel) {
        return interaction.reply({
          content: '❌ O canal de ranking configurado não foi encontrado. Verifique o ID.',
          ephemeral: true
        });
      }

      const { embed, components } = buildPanelComponents();
      const savedMsgId = await getPanelMessageId();

      if (savedMsgId) {
        try {
          const oldMessage = await channel.messages.fetch(savedMsgId);
          await oldMessage.delete();
        } catch {
          // Mensagem antiga não existe mais
        }
      }

      const newMessage = await channel.send({ embeds: [embed], components });
      await setPanelMessageId(newMessage.id);

      return interaction.reply({
        content: `✅ Painel persistente configurado com sucesso no canal <#${RANKING_CHANNEL_ID}>!`,
        ephemeral: true
      });
    }

    // 2. Ações de Botões
    if (interaction.isButton()) {
      if (interaction.customId === 'btn_view_ranking') {
        const players = await getAllPlayers();
        const rankingEmbed = buildRankingEmbed(players);
        return interaction.reply({ embeds: [rankingEmbed], ephemeral: true });
      }

      // Restrição para botões administrativos
      if (!hasOwnerRole(interaction.member)) {
        return interaction.reply({
          content: '🔒 Você não possui permissão para utilizar esta função.',
          ephemeral: true
        });
      }

      const buttonConfigs = {
        'btn_win': { id: 'select_win', label: 'Selecione o jogador vencedor (+3 pontos)' },
        'btn_remove_win': { id: 'select_remove_win', label: 'Selecione o jogador para remover vitória (-3 pontos)' },
        'btn_penalty': { id: 'select_penalty', label: 'Selecione o jogador para penalizar (-2 pontos)' },
        'btn_add_player': { id: 'select_add_player', label: 'Selecione o membro para adicionar ao ranking' },
        'btn_remove_player': { id: 'select_remove_player', label: 'Selecione o membro para remover do ranking' }
      };

      const selectedConfig = buttonConfigs[interaction.customId];
      if (selectedConfig) {
        const userSelect = new UserSelectMenuBuilder()
          .setCustomId(selectedConfig.id)
          .setPlaceholder(selectedConfig.label)
          .setMinValues(1)
          .setMaxValues(1);

        const row = new ActionRowBuilder().addComponents(userSelect);
        return interaction.reply({ components: [row], ephemeral: true });
      }
    }

    // 3. Menus de Seleção de Usuários
    if (interaction.isUserSelectMenu()) {
      if (!hasOwnerRole(interaction.member)) {
        return interaction.reply({
          content: '🔒 Você não possui permissão para utilizar esta função.',
          ephemeral: true
        });
      }

      const targetId = interaction.values[0];
      const targetUser = interaction.users.get(targetId);
      const player = await getPlayer(targetId);

      switch (interaction.customId) {
        case 'select_add_player': {
          if (player) {
            return interaction.update({ content: `⚠️ <@${targetId}> já está registrado no ranking.`, components: [] });
          }
          await addPlayer(targetId, targetUser ? targetUser.username : 'Desconhecido');
          return interaction.update({ content: `👤 <@${targetId}> foi adicionado ao ranking com **0 pontos**.`, components: [] });
        }

        case 'select_remove_player': {
          if (!player) {
            return interaction.update({ content: `⚠️ <@${targetId}> não faz parte do ranking.`, components: [] });
          }
          await removePlayer(targetId);
          return interaction.update({ content: `❌ <@${targetId}> foi removido do ranking e seu histórico foi limpo.`, components: [] });
        }

        case 'select_win': {
          if (!player) {
            return interaction.update({ content: `⚠️ <@${targetId}> não está cadastrado. Adicione o jogador primeiro.`, components: [] });
          }
          await registerWin(targetId, interaction.user.id);
          return interaction.update({ content: `🟢 Vitória registrada! **+3 pontos** para <@${targetId}>. Total: **${player.points + 3} pontos**.`, components: [] });
        }

        case 'select_remove_win': {
          if (!player) {
            return interaction.update({ content: `⚠️ <@${targetId}> não está cadastrado.`, components: [] });
          }
          if (player.wins <= 0) {
            return interaction.update({ content: `⚠️ <@${targetId}> não possui vitórias registradas para remover.`, components: [] });
          }
          await removeWin(targetId, interaction.user.id);
          const newPoints = Math.max(0, player.points - 3);
          return interaction.update({ content: `🔴 Vitória removida! **-3 pontos** de <@${targetId}>. Total: **${newPoints} pontos**.`, components: [] });
        }

        case 'select_penalty': {
          if (!player) {
            return interaction.update({ content: `⚠️ <@${targetId}> não está cadastrado.`, components: [] });
          }
          await applyPenalty(targetId, interaction.user.id);
          const newPoints = Math.max(0, player.points - 2);
          return interaction.update({ content: `⚠️ Penalidade aplicada! **-2 pontos** para <@${targetId}>. Total: **${newPoints} pontos**.`, components: [] });
        }
      }
    }
  } catch (error) {
    console.error('[ERRO INTERAÇÃO]', error);
    if (!interaction.replied && !interaction.deferred) {
      await interaction.reply({ content: '❌ Ocorreu um erro ao processar esta ação.', ephemeral: true });
    }
  }
});

client.login(process.env.DISCORD_TOKEN);
